generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  balance       Float     @default(50000.0) // Initial demo balance
  trades        Trade[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String   // e.g., "BTC/USDT"
  type      String   // "BUY" or "SELL"
  amount    Float
  price     Float
  total     Float
  timestamp DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  type      String   // "BUY" or "SELL"
  status    String   // "PENDING", "COMPLETED", "CANCELLED"
  amount    Float
  price     Float
  createdAt DateTime @default(now())
}
